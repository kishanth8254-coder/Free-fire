{
  "entities": {
    "Category": {
      "title": "Category",
      "description": "A service category (e.g., Diamond Top-Up)",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the category"
        },
        "slug": {
          "type": "string",
          "description": "The slug of the category (e.g., topup)"
        },
        "displayOrder": {
          "type": "integer",
          "description": "The order in which to display the category"
        }
      },
      "required": ["name", "slug"]
    },
    "Package": {
      "title": "Package",
      "description": "A package within a category",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the package"
        },
        "price": {
          "type": "number",
          "description": "The price of the package"
        },
        "description": {
          "type": "string",
          "description": "The description of the package"
        },
        "badge": {
          "type": "string",
          "description": "Optional badge/tag (e.g., Most Popular)"
        },
        "buttonText": {
          "type": "string",
          "description": "The text for the button"
        },
        "status": {
          "type": "string",
          "enum": ["active", "inactive"],
          "description": "The status of the package"
        },
        "displayOrder": {
          "type": "integer",
          "description": "The order in which to display the package"
        },
        "categoryId": {
          "type": "string",
          "description": "The ID of the category this package belongs to"
        }
      },
      "required": ["name", "price", "categoryId"]
    }
  },
  "firestore": {
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Service categories"
    },
    "/packages/{packageId}": {
      "schema": "Package",
      "description": "Service packages"
    }
  }
}
